# ==============================================================================
# IncidentOps AI: Environment Configuration Template
# ==============================================================================

# Application Environment (development | staging | production | test)
APP_ENV=development
DEBUG=true
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# LLM Provider Configuration
# Options: ollama (local testing) | anthropic | gemini | openai | mock
LLM_PROVIDER=ollama

# Local Ollama Settings (for local testing without external API keys)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT_SECONDS=120

# Anthropic Claude 3.5 Sonnet (Production Model)
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-api-key-here
PRIMARY_MODEL=claude-3-5-sonnet-20241022

# Alternative Providers (Optional Fallback)
GEMINI_API_KEY=
OPENAI_API_KEY=

# LangGraph Finite State Machine (FSM) Guards
MAX_ITERATION_GUARD=3

# Slack Interactive Webhook & Cryptographic Verification
SLACK_SIGNING_SECRET=incidentops-dev-secret-key-hmac-sha256-signature
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL=#incidents-critical
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# PostgreSQL Checkpointer (Production StateGraph Persistence)
ENABLE_POSTGRES_CHECKPOINTER=false
POSTGRES_DB_URI=postgresql://incidentops:secretpassword@localhost:5432/incidentops_checkpoints

# Model Context Protocol (MCP) Live Observability Endpoints
# Set USE_MOCK_MCP=true to run offline without live servers
USE_MOCK_MCP=true
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
ELASTICSEARCH_URL=http://localhost:9200
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
K8S_NAMESPACE_DEFAULT=production
